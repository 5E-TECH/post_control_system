PORT=

DB_URL=

SUPERADMIN_FIRSTNAME=
SUPERADMIN_LASTTNAME=
SUPERADMIN_PHONE_NUMBER=
SUPERADMIN_PASSWORD=

ACCESS_TOKEN_KEY=
ACCESS_TOKEN_TIME=
REFRESH_TOKEN_KEY=
REFRESH_TOKEN_TIME=

HOST_URL=

# ---- DB backup (optional) ----
# S3 bucket nomi (Lightsail Object Storage yoki AWS S3)
# Bo'sh qoldirilsa, faqat lokal backup saqlanadi.
S3_BACKUP_BUCKET=

# ---- Telegram botlar ----
#
# BOTS_ENABLED — botlar ishga tushsinmi. Bo'sh qoldirilsa YOQILGAN.
#
# ⚠️ QUYIDAGI `BOTS_ENABLED=false` SATRI ATAYLAB shunday — bu shablon
# LOKAL ishlash uchun mo'ljallangan.
#
# PRODGA ko'chirsangiz o'sha satrni O'CHIRING. Esdan chiqsa ham xavf yo'q:
# `NODE_ENV=production` bo'lganda ilova UMUMAN KO'TARILMAYDI va sababini
# aytadi (src/api/app.service.ts). Prodda ataylab o'chirish kerak bo'lsa
# (masalan Telegram tomonidagi incident) — `BOTS_DISABLED_ACK=i-know`
# qo'shiladi.
#
# Aks holda Telegraf shu tokenlar bilan POLLING ochadi va lokal nusxa
# botga kelayotgan xabarlarni O'ZIGA TORTIB oladi — Telegram bitta
# `getUpdates` oqimini faqat bitta iste'molchiga beradi, ya'ni asosiy
# bot ularni KO'RMAY qoladi. Agar tokenlar ishlab turgan bot tokeni
# bo'lsa, bu mijoz xabarlarining yo'qolishiga olib keladi.
#
# `false` bo'lganda ikki qatlam yopiladi:
#   · polling boshlanmaydi (`launchOptions: false`);
#   · chiquvchi chaqiruvlar ham yuborilmaydi
#     (src/common/utils/bot-mute.util.ts — Telegraf `callApi` jimlatiladi),
#     chunki lokal bazadagi `group_id` lar haqiqiy guruhlarga ishora
#     qilishi mumkin.
#
# ⚠️ AYNAN `false` deb yozilishi kerak — boshqa qiymat botlarni
# jimgina o'chirib qo'ymaydi.
BOTS_ENABLED=false

BOT_TOKEN=

# ---- AI (Claude) — matndan buyurtma yaratish ----
# Bo'sh qoldirilsa AI oqimi o'chadi, WebApp forma ishlayveradi.
ANTHROPIC_API_KEY=
# Ekstraksiya modeli: claude-sonnet-4-6 (arzon balans, default) | claude-opus-4-8 (eng aniq)
AI_ORDER_MODEL=claude-sonnet-4-6
# Rasm orqali buyurtma (vision) ekstraksiya modeli — rasmdagi matnni o'qiydi.
# Vision qo'llaydigan model bo'lishi SHART (opus/sonnet/haiku). Default: sonnet (balans).
AI_ORDER_VISION_MODEL=claude-sonnet-4-6
# Moliyaviy AI (Elchin) modeli — hisobot/savol-javob/fayl tahlili. Sonnet default
# (aql kodda, model faqat izohlaydi -> arzon+mukammal). Kerak bo'lsa: claude-opus-4-8
AI_FINANCE_MODEL=claude-sonnet-4-6
# Mexanik/mayda AI ishlari (tuman indeks tanlash, mahsulot moslash, izoh
# kategoriyalash) — arzon model bemalol uddalaydi (bo'sh -> haiku-4-5)
AI_CLASSIFY_MODEL=claude-haiku-4-5
# Bir AI buyurtma narxi (so'm) — market ai_price_per_order null bo'lsa shu default
AI_PRICE_PER_ORDER=300
# USD -> so'm kursi — AI REAL xarajatini (Anthropic hisobi USD'da) so'mga
# aylantirish uchun (ai_usage_log + AI dashboard). Kurs endi CBU (Markaziy bank)
# API'sidan AVTOMATIK olinadi (kunlik kesh); bu qiymat faqat CBU ishlamay qolsa
# FALLBACK sifatida ishlatiladi. Eski yozuvlar o'z kursini saqlaydi (audit).
AI_USD_UZS_RATE=12800

# ---- Yuklanadigan fayllar (qo'shimcha xarajat ISBOTI) ----
# MUTLAQ yo'l, deploy papkasidan TASHQARIDA bo'lishi SHART.
#
# Nega: isbot foto — kuryer bilan market o'rtasidagi pul nizosining yagona
# dalili. Deploy papkasi ichida tursa, har `git clone` / `rsync --delete` /
# yangi relizda o'chib ketadi va bahsni hal qilib bo'lmay qoladi.
#
# Production'da bu o'rnatilmagan bo'lsa server UMUMAN KO'TARILMAYDI
# (`assertProofStorageConfigured`) — jimgina noto'g'ri joyga yozishdan
# ko'ra to'xtagan yaxshi.
#
# Serverda bir marta tayyorlash:
#   sudo mkdir -p /var/beepost/uploads/extra-cost-proofs
#   sudo chown -R ubuntu:ubuntu /var/beepost/uploads
UPLOAD_ROOT=/var/beepost/uploads

# Video isbotni siqish uchun ffmpeg yo'li.
# Bo'sh qoldirilsa PATH dan `ffmpeg` qidiriladi.
# ⚠️ ffmpeg topilmasa server ISHLAYVERADI — videolar shunchaki asl (katta)
# hajmda saqlanadi. O'rnatish: sudo apt-get install -y ffmpeg
FFMPEG_PATH=ffmpeg

# ═══════════════ MARKETPLACE INTEGRATSIYASI ═══════════════
# Marketplace API kaliti va imzo sekretini bazada SHIFRLASH kaliti (AES-256-GCM).
#
# ⚠️ Kamida 16 belgi. Kalit YO'Q bo'lsa server ISHLAYVERADI, lekin sekretlar
# OCHIQ MATN saqlanadi va startda ogohlantirish chiqadi.
#
# ⚠️ KALITNI O'ZGARTIRMANG: eski kalit bilan shifrlangan qatorlar o'qilmay
# qoladi va integratsiya 401 bilan to'xtaydi. Almashtirish kerak bo'lsa —
# avval sekretlarni qayta kiriting.
MARKETPLACE_SECRET_KEY=
