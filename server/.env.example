PORT=

DB_URL=

SUPERADMIN_FIRSTNAME=
SUPERADMIN_LASTTNAME=
SUPERADMIN_PHONE_NUMBER=
SUPERADMIN_PASSWORD=

ACCESS_TOKEN_KEY=
ACCESS_TOKEN_TIME=
REFRESH_TOKEN_KEY=
REFRESH_TOKEN_TIME=

HOST_URL=

# ---- DB backup (optional) ----
# S3 bucket nomi (Lightsail Object Storage yoki AWS S3)
# Bo'sh qoldirilsa, faqat lokal backup saqlanadi.
S3_BACKUP_BUCKET=

BOT_TOKEN=

# ---- AI (Claude) — matndan buyurtma yaratish ----
# Bo'sh qoldirilsa AI oqimi o'chadi, WebApp forma ishlayveradi.
ANTHROPIC_API_KEY=
# Ekstraksiya modeli: claude-opus-4-8 (eng aniq) | claude-sonnet-4-6 (arzon balans)
AI_ORDER_MODEL=claude-opus-4-8
# Moliyaviy AI (Elchin) modeli — hisobot/savol-javob/fayl tahlili (bo'sh -> opus-4-8)
AI_FINANCE_MODEL=claude-opus-4-8
# Mexanik/mayda AI ishlari (tuman indeks tanlash, mahsulot moslash, izoh
# kategoriyalash) — arzon model bemalol uddalaydi (bo'sh -> haiku-4-5)
AI_CLASSIFY_MODEL=claude-haiku-4-5
# Bir AI buyurtma narxi (so'm) — market ai_price_per_order null bo'lsa shu default
AI_PRICE_PER_ORDER=300
# USD -> so'm kursi — AI REAL xarajatini (Anthropic hisobi USD'da) so'mga
# aylantirish uchun (ai_usage_log + AI dashboard). Kurs endi CBU (Markaziy bank)
# API'sidan AVTOMATIK olinadi (kunlik kesh); bu qiymat faqat CBU ishlamay qolsa
# FALLBACK sifatida ishlatiladi. Eski yozuvlar o'z kursini saqlaydi (audit).
AI_USD_UZS_RATE=12800